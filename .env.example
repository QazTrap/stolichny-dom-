# Адрес портала КГД. При официальной смене домена меняется только эта переменная.
KGD_PORTAL_HOST=https://portal.kgd.gov.kz

# Получить у администратора КГД МФ РК. Никогда не добавлять токен во frontend.
KGD_API_TOKEN=

# Публичный адрес сайта, который будет закодирован в QR.
PUBLIC_APP_URL=https://stoldom.site

